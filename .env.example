# Atlas Control Plane — environment template.
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this template is not.
#
# ATLAS DOES NOT READ THIS FILE BY ITSELF. There is no dotenv dependency (the runtime is
# stdlib-only on purpose), so a value written here has no effect until a shell exports it:
#
#     set -a; source .env; set +a
#     python3 -m atlas
#
# In production use systemd's own EnvironmentFile instead (docs/ops/deployment.md §2).
#
# Every name below is one the code actually reads; the defaults quoted are the ones in
# atlas/config.py, so an omitted line is the documented default and not a guess.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8787
ATLAS_DB=./data/atlas.sqlite
# ATLAS_HOME=.                       # root for default paths; default: cwd
# ATLAS_UPLOAD_DIR=./data/uploads    # default: <ATLAS_DB dir>/uploads
# ATLAS_REQUEST_TIMEOUT=30           # seconds
# ATLAS_REQUEST_LOG=false
# ATLAS_SERVE_UI=true                # serves the built-in operator dashboard
# ATLAS_CORS_ORIGINS=                # comma-separated; empty allows none

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Treats every loopback request as the built-in admin, bypassing ALL role checks.
# Local development only — never enable on a shared or production host.
ATLAS_LOOPBACK_NO_AUTH=true
# ATLAS_API_TOKEN=                   # legacy single admin token; per-user tokens are preferred
# ATLAS_SESSION_TOKEN_TTL_SECONDS=28800
# ATLAS_MAX_ACTIVE_SESSIONS=5
# ATLAS_LOGIN_RATE_LIMIT_ATTEMPTS=5
# ATLAS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# ATLAS_LOGIN_RATE_LIMIT_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Signs outbound webhook bodies (X-Atlas-Signature) and the usage export, and encrypts
# worker tokens written while it is set.
#
# Without it Atlas REFUSES to send any outbound delivery rather than send it unsigned, so
# approval reminders never leave the process.
#
# Two things to know before setting it on an existing database: a worker token stored as
# plaintext keeps working unchanged, but any token written from now on is encrypted with
# this key and is unreadable if the key is lost. Treat it as permanent.
#
#     openssl rand -hex 32
ATLAS_SECRET_KEY=replace-me-with-32-random-bytes-hex
# ATLAS_BYOK_KEY=                    # optional per-provider model key (see atlas/byok.py)
# ATLAS_REQUIRE_SIGNED_PACKS=false

# ---------------------------------------------------------------------------
# Outbound webhooks
# ---------------------------------------------------------------------------
# Hostnames or CIDRs Atlas may POST to. EMPTY MEANS OUTBOUND IS DISABLED (secure default) —
# every delivery is recorded `blocked` and nothing is sent. This is also what gates a
# per-workflow policy.approval_webhook_url, so a workflow author can only address hosts an
# operator already allowed.
ATLAS_OUTBOUND_ALLOWLIST=127.0.0.1
# ATLAS_OUTBOUND_MAX_ATTEMPTS=5      # then the delivery dead-letters as `failed`
# ATLAS_OUTBOUND_TIMEOUT=10          # seconds, TOTAL per attempt (connect + request + headers)

# ---------------------------------------------------------------------------
# Approval reminders (D2c-2)
# ---------------------------------------------------------------------------
# Deployment defaults for approvals left waiting. Both are overridden per workflow by
# policy.approval_webhook_url / policy.approval_overdue_hours in the Run policy panel.
#
# The URL must point at something you have BUILT — Atlas only POSTs a signed JSON body; it
# sends no email or chat. `poc/approval_reminder_receiver.py` is a runnable reference.
# With no URL configured anywhere, the sweep is inert and nothing is sent.
#
# Hours are wall clock, ascending, and the position in the list is the escalation level
# (72 = first reminder, 168 = escalation). Business days and holidays are the receiver's to
# apply, so leave room for a weekend rather than using a literal 48.
# ATLAS_APPROVAL_WEBHOOK_URL=http://127.0.0.1:9000/atlas/approval-overdue
ATLAS_APPROVAL_OVERDUE_HOURS=72,168

# ---------------------------------------------------------------------------
# Atlas Notify sidecar (notify/ — a SEPARATE process, not read by Atlas itself)
# ---------------------------------------------------------------------------
# The deployable receiver for the reminders above: python3 -m notify --config <file>.
# Routing/channel settings live in its JSON config; secrets live ONLY here — the sidecar
# refuses a config file containing password/token keys. See notify/README.md.
# ATLAS_NOTIFY_CONFIG=/etc/atlas/notify.json
# ATLAS_NOTIFY_DB=data/notify.sqlite
# ATLAS_NOTIFY_SMTP_PASSWORD=        # required iff channels.smtp.username is set
# ATLAS_NOTIFY_TELEGRAM_TOKEN=       # required iff any telegram target exists

# ---------------------------------------------------------------------------
# Jobs, streaming, and artifacts
# ---------------------------------------------------------------------------
# ATLAS_PUBLIC_BASE_URL=             # externally reachable Atlas URL; required for
#                                    # execution:"callback" jobs, rejected at submit without it
# ATLAS_CALLBACK_TIMEOUT_SECONDS=3600
# ATLAS_CALLBACK_REAPER_INTERVAL_SECONDS=
# ATLAS_COLLECT_DEADLINE_SECONDS=
# ATLAS_MAX_STREAM_SECONDS=
# ATLAS_MAX_JOB_OUTPUT_BYTES=
ATLAS_MAX_UPLOAD_BYTES=33554432
# ATLAS_ARTIFACT_MAX_BYTES=
# ATLAS_ARTIFACT_MAX_FILES=
# ATLAS_ARTIFACT_CLOCK_SKEW_SECONDS=
# ATLAS_SYNC_MAX_BYTES=
# ATLAS_SYNC_MAX_FILES=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# Read by scripts/backup.sh, NOT by the server: when set, backups are written as
# AES-256-CBC .enc and the plaintext copy is removed (docs/ops/backup-restore.md).
# ATLAS_BACKUP_KEY=
